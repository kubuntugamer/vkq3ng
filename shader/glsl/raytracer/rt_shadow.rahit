#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_nonuniform_qualifier : enable
#include "defines.glsl"
#include "globalTexture.glsl"
#include "vertexData.glsl"

layout(location = PAYLOAD_SHADOW) rayPayloadInEXT ShadowRayPayload rp;
hitAttributeEXT vec2 hitAttribute;

void main()
{
    //if (alphaTestFails(attribs))
	//	IgnoreHit();
    
    RayPayload rpb;
    rpb.barycentric = hitAttribute;
    rpb.instanceID = gl_InstanceID;
    rpb.primitiveID = gl_PrimitiveID;
    rpb.hit_distance = gl_RayTmaxEXT;
    uint material = get_material(rpb);

    //ignoreIntersectionEXT;
    //HitPoint hp = getHitPoint(rpb);
    //if(isGlass(hp.material)) ignoreIntersectionEXT;
    //rp.visFactor = 1.0f;
    // if(isLight(material)) ignoreIntersectionEXT;
    HitPoint hp = getHitPoint(rpb);
	vec4 tex = getTextureWithLod(hp,0);

    if(isLight(material)) ignoreIntersectionEXT;
    if(isGlass(material)) ignoreIntersectionEXT;
    if(isWater(material)) ignoreIntersectionEXT;
    if(isSeeThrough(material) && tex.w < 0.5) ignoreIntersectionEXT;
    if(isSeeThroughAdd(material)) ignoreIntersectionEXT;
    if(isSeeThroughNoAlpha(material)) ignoreIntersectionEXT;
    // if(isWater(material)) ignoreIntersectionEXT;
//ignoreIntersectionEXT;
    // if(isSeeThrough(material)) ignoreIntersectionEXT;
    // if(isSeeThroughAdd(material)) ignoreIntersectionEXT;

    // HitPoint hp = getHitPoint(rpb);
	// vec4 tex = getTextureWithLod(hp,0);
    
    //if(tex.w < 0.5f) ignoreIntersectionEXT;
    //     // global_texture(hp.tex0 & TEX0_IDX_MASK, hp.uv0).y < 0.1 &&
    //     // global_texture(hp.tex0 & TEX0_IDX_MASK, hp.uv0).z < 0.1) ignoreIntersectionEXT;
    // if(is_see_through(rpb)) {
    //     HitPoint hp = getHitPoint(rpb);
    //     //if(all(equal(global_texture(hp.tex0 & TEX0_IDX_MASK, hp.uv0).xyz, vec3(0)))) ignoreIntersectionEXT;
    //     // if(global_texture(hp.tex0 & TEX0_IDX_MASK, hp.uv0).x < 0.1 &&
    //     // global_texture(hp.tex0 & TEX0_IDX_MASK, hp.uv0).y < 0.1 &&
    //     // global_texture(hp.tex0 & TEX0_IDX_MASK, hp.uv0).z < 0.1) ignoreIntersectionEXT;
         
    //     if(global_texture(hp.tex0 & TEX0_IDX_MASK, hp.uv0).w < 0.5) ignoreIntersectionEXT;
    // }
    
}